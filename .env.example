# Optional configuration: copy to .env and load explicitly with Node.
# Production (after npm run build): node --env-file=.env server/index.js
# Development: node --env-file=.env --watch server/index.js --dev
HOST=127.0.0.1
PORT=3000
# Relative database paths resolve from the directory where you run Node.
DB_PATH=./data/soliddraft.sqlite
